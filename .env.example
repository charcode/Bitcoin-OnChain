# Copy to .env. Never commit real credentials.
BTC_RPC_URL=http://host.docker.internal:8332
BTC_RPC_USER=replace_me
BTC_RPC_PASS=replace_me
# This URL is used by the browser and baked into the frontend build.
VITE_API_URL=http://127.0.0.1:8000
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
FULCRUM_ENABLED=false
FULCRUM_HOST=host.docker.internal
FULCRUM_PORT=50001
FULCRUM_SSL=false

# Supported price search range; adjust to your model evaluation regime.
PRICE_MIN=30000
PRICE_MAX=1000000
