# Copy this file to .env.docker or .env, then adjust paths and credentials.

# Host paths for services that already exist outside this repository.
DATUM_GATEWAY_BUILD=F:/bitcoin/datum_gateway/build
FULCRUM_CONF=F:/bitcoin/Fulcrum-1.12.0-win64/fulcrum.conf
FULCRUM_DATA=F:/bitcoin/fulcrum-data

# Bitcoin Knots RPC reachable from Docker Desktop containers.
BTC_RPC_URL=http://host.docker.internal:8332
BTC_RPC_USER=youruser
BTC_RPC_PASS=yourpass

# Backend to Fulcrum container connection.
FULCRUM_ENABLED=true
FULCRUM_HOST=fulcrum
FULCRUM_PORT=50002
FULCRUM_SSL=true
FULCRUM_SSL_VERIFY=false
FULCRUM_TIMEOUT=30

# Backend estimator/runtime tuning.
DECODE_PER_TICK=50
SCAN_INTERVAL=0.75
LOOKBACK_SEC=900
MIN_SAMPLES=500
PRICE_MIN=20000
PRICE_MAX=120000
PRICE_STEP=50
SIGMA=75
EMA_ALPHA=0.25
EXT_PRICE_ENABLED=false

# Browser-facing API URL baked into the frontend image.
VITE_API_URL=http://127.0.0.1:8000

BACKEND_PORT=8000
FRONTEND_PORT=5173
FULCRUM_TCP_PORT=50001
FULCRUM_SSL_PORT=50002
FULCRUM_VERSION=1.12.0
