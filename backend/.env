# --- btc-onchain live nowcaster configuration ---

# How far back to keep mempool outputs in seconds (default: 15 min)
LOOKBACK_SEC=900

# How often to poll mempool RPC (seconds)
POLL_INTERVAL=1

# How often to compute RNR / stencil estimate (seconds)
SCAN_INTERVAL=1

# Limit how many *new* tx to decode per poll
DECODE_PER_TICK=200

# Recheck a tx is still in the mempool before caching its outputs
RECHECK_MEMPOOL=true


# ===========================
#   PRICE ESTIMATION RANGE
# ===========================

# USD price search band
PRICE_MIN=30000
PRICE_MAX=1000000
PRICE_STEP=50

# Minimum number of samples before applying stencils
MIN_SAMPLES=5

# Exponential moving average smoothing for live feed
EMA_ALPHA=0.25


# ===========================
#   ROUND-NUMBER RESONANCE
# ===========================

# Common USD “grid” amounts for resonance / stencil spikes
RNR_GRIDS=10,25,50,100,250,500,1000,2000,5000,10000

# Roundness kernel width (controls Gaussian smoothness)
SIGMA=0.06


# ===========================
#   HISTOGRAM & STENCIL LOGIC
# ===========================

# Histogram range in log10 BTC (10^-6 → 10^6)
HIST_LOG10_MIN=-6
HIST_LOG10_MAX=6
HIST_BINS_PER_DECADE=200

# Amount filters (in BTC or sats equivalent)
AMOUNT_LOWER_CLIP_SATS=10000
AMOUNT_UPPER_CLIP_BTC=10

# Smooth over round BTC bins (remove sat-round clusters)
ROUND_BTC_SMOOTH=true
ROUND_BTC_BIN_INDEXES=201,401,461,496,540,601,661,696,740,801,861,896,940,1001,1061,1096,1140,1201

# Smooth vs spike stencil weighting
STENCIL_SMOOTH_WEIGHT=0.65
STENCIL_SPIKE_WEIGHT=1.0

# Bin index where 0.001 BTC ≈ $100 at baseline
STENCIL_CENTER_P001=601
# Slide range for stencil alignment (in bins)
STENCIL_MIN_SLIDE=-141
STENCIL_MAX_SLIDE=201

# Price refinement windows (Step 10–11 analog)
PRICE_RANGE_WIDE_PCT=0.25
PRICE_RANGE_TIGHT_PCT=0.05


# ===========================
#   DISPLAY / OUTPUT
# ===========================

# FastAPI server config
HOST=0.0.0.0
PORT=8000

# Chart canvas defaults (used if you render the HTML view)
CANVAS_WIDTH=1000
CANVAS_HEIGHT=660
CANVAS_MARGIN_LEFT=120
CANVAS_MARGIN_RIGHT=90
CANVAS_MARGIN_TOP=100
CANVAS_MARGIN_BOTTOM=120
XTICKS=5

# Logging level
LOG_LEVEL=INFO
