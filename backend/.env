# --- btc-onchain defaults ---

# How far back to keep mempool outputs in seconds (default: 15 min)
LOOKBACK_SEC=900

# How often to poll mempool RPC (seconds)
POLL_INTERVAL=5

# How often to compute RNR estimate (seconds)
SCAN_INTERVAL=10

# don’t try to decode the whole mempool each tick—cap the work
DECODE_PER_TICK=200          # how many *new* tx to decode per poll

# double-check a tx is still in the mempool before caching its outputs
RECHECK_MEMPOOL=true

# Price search band (USD)
PRICE_MIN=30000
PRICE_MAX=120000
PRICE_STEP=50

# Roundness kernel width
SIGMA=0.06

# Exponential moving average alpha
EMA_ALPHA=0.25
MIN_SAMPLES=5


# Grids for resonance (common round USD amounts)
RNR_GRIDS=10,25,50,100,250,500,1000,2000,5000,10000

# FastAPI server config (optional)
HOST=0.0.0.0
PORT=8000
